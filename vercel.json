{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(?!assets)(.*)\\.(?!js|css|svg|png|jpg|jpeg|gif|webp|ico|json)(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(?!assets).*",
      "destination": "/index.html"
    }
  ]
}
